# Copy this file to .env and change the password to the one you set in PostgreSQL
DATABASE_URL=postgresql+psycopg://astropulse:astropulse_pw@localhost:5432/astropulse
# Where the React dev server runs (comma separated if more than one)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mission Control (admin) account created on first start if no admin exists.
# CHANGE THE PASSWORD before showing the app to anyone.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mission2026

# Secret used to sign login passes. Leave empty: the API generates one and saves it here.
JWT_SECRET=
